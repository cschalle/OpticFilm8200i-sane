From 8801c199b23e9bfe8a266553a91b25941e394dbc Mon Sep 17 00:00:00 2001
From: "Christian F.K. Schaller" <christian.schaller@gmail.com>
Date: Wed, 21 Oct 2026 12:08:45 -0400
Subject: [PATCH 6/7] genesys: Document the OpticFilm 8200i SE improvements

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 doc/descriptions/genesys.desc                       | 2 +-
 newsfragments/genesys_gl128_8200i_se_parity.backend | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)
 create mode 100644 newsfragments/genesys_gl128_8200i_se_parity.backend

diff --git a/doc/descriptions/genesys.desc b/doc/descriptions/genesys.desc
index 4f2f8050b..b95ebb56f 100644
--- a/doc/descriptions/genesys.desc
+++ b/doc/descriptions/genesys.desc
@@ -75,7 +75,7 @@
 :interface "USB"
 :usbid "0x07b3" "0x1825"
 :status :basic
-:comment "GL128 based. 16-bit colour and gray transparency scans at 150-7200 dpi; no infrared yet"
+:comment "GL128 based. 8- and 16-bit colour and gray transparency scans, regular and infrared, at 150-7200 dpi; IntelliScan and QuickScan buttons"
 
 ; -----------------------------------------------------------------------------
 
diff --git a/newsfragments/genesys_gl128_8200i_se_parity.backend b/newsfragments/genesys_gl128_8200i_se_parity.backend
new file mode 100644
index 000000000..2eb965aaf
--- /dev/null
+++ b/newsfragments/genesys_gl128_8200i_se_parity.backend
@@ -0,0 +1 @@
+genesys: Improved scans on the Plustek OpticFilm 8200i SE (GL128): the whole film gate is scanned, the front-end gain is chosen from the lit gate, and 8-bit output, an infrared scan source and the IntelliScan and QuickScan buttons were added.
