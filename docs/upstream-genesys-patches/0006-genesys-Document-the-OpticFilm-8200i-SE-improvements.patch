 doc/descriptions/genesys.desc                       | 2 +-
 newsfragments/genesys_gl128_8200i_se_parity.backend | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)
 create mode 100644 newsfragments/genesys_gl128_8200i_se_parity.backend

diff --git a/doc/descriptions/genesys.desc b/doc/descriptions/genesys.desc
index 4f2f8050..b95ebb56 100644
--- a/doc/descriptions/genesys.desc
+++ b/doc/descriptions/genesys.desc
@@ -75,7 +75,7 @@
 :interface "USB"
 :usbid "0x07b3" "0x1825"
 :status :basic
-:comment "GL128 based. 16-bit colour and gray transparency scans at 150-7200 dpi; no infrared yet"
