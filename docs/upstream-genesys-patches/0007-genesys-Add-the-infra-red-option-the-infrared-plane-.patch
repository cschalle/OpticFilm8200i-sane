   OPT_GEOMETRY_GROUP,
   OPT_TL_X,			/* top-left x */
@@ -209,6 +210,14 @@ struct Genesys_Scanner
     // the value of the source option
     ScanMethod scan_method = ScanMethod::FLATBED;
 
